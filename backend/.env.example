# ===== AgentMesh 后端配置模板 =====
# 用法：复制为 backend/.env 后按需填写。除云端主脑的 key 外都有默认值，不填也能跑。
# 注意：.env 已在 .gitignore 里，请勿提交真实密钥。

APP_HOST=127.0.0.1
APP_PORT=8787

# ---------- 本地模型 ----------
# Ollama 需先 `ollama serve`，并 pull 对应模型
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b

# ---------- 云端主脑（M4 拆解计划用）----------
# 不填 key 时：拆解会明确报错（不会假装成功），其余功能不受影响。
CLOUD_BASE_URL=https://api.deepseek.com
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-flash
CONDUCTOR_MODEL=deepseek-flash
CLOUD_JSON_MODE=true
# token 硬上限与估价（元 / 百万 token），用于用量账本与预算闸门
CONDUCTOR_BUDGET_TOKENS=200000
CLOUD_PRICE_IN=0.5
CLOUD_PRICE_OUT=1.5

# ---------- 桥接 ----------
# WorkBuddy 桌面端：必须用 spike/wb_debug_launch.bat 以该端口启动，否则接不上
WB_CDP_PORT=9444
# 豆包：需以 --remote-debugging-port=9333 启动（见 spike/launch_doubao_debug.cmd）
DOUBAO_DEBUG_PORT=9333
DOUBAO_EXE=
BRIDGE_ENABLED=true

# ---------- 开关 ----------
# Codex：已接入但默认不启用（本机无额度、未登录）。恢复后改成 true 并重启后端
CODEX_ENABLED=false

# ---------- 历史遗留 ----------
# WorkBuddy CLI 路线已弃用：本机存不住 OAuth 凭据（at-rest 加密缺 key），
# API Key 也拿不到，-p 模式跑不通，故改为驱动桌面端。留空即可。
CODEBUDDY_API_KEY=
